# Copy this file to ".env" and fill in the values.
# .env is ignored by git, so your keys stay on this computer.

# --- Database (Supabase) ---
# Session pooler connection string, WITHOUT the password.
# (Supabase dashboard -> Project Settings -> Database. Use the session pooler:
# the direct connection only works on IPv6 networks.)
DATABASE_URL=postgresql://postgres.xxxxxxxx@aws-0-us-west-2.pooler.supabase.com:5432/postgres
# Your Supabase database password. Paste it exactly as-is; special characters are fine.
# Forgot it? Reset it in Supabase: Project Settings -> Database -> Reset database password.
DATABASE_PASSWORD=

# --- Claude (concept clustering) ---
ANTHROPIC_API_KEY=

# --- Data sources ---
KALODATA_API_KEY=
APIFY_API_TOKEN=
# Only needed if we use SerpApi instead of Apify for Google Trends
SERPAPI_API_KEY=

# Reddit: create a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=gapfinder/0.1 by your_reddit_username
